# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_MAX_RETRIES=3
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=2

# Stream
STREAM_NAME=events
STREAM_CONSUMER_GROUP=workers
STREAM_CONSUMER_NAME=worker
STREAM_MAX_LEN=10000
STREAM_READ_COUNT=10
STREAM_BLOCK_TIMEOUT=2s
STREAM_DEAD_LETTER=events.dlq

# Worker
WORKER_CONCURRENCY=4
WORKER_RETRY_ATTEMPTS=3
WORKER_RETRY_BASE_DELAY=100ms
WORKER_RETRY_MAX_DELAY=10s
WORKER_SHUTDOWN_TIMEOUT=30s

# HTTP
HTTP_ADDR=:8080

# Logging
LOG_LEVEL=info
LOG_JSON=true

# Grafana alerting
GF_ALERT_WEBHOOK_URL=http://alert-webhook.invalid/alerts
